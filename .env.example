# Copy this file to .env locally. Never commit your actual API key.
AI_MODE=disabled
AI_ENABLE_REAL_REQUESTS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=30000
PORT=3000

